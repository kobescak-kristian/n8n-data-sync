{
 "name": "Q129 Summary: daily summary",
 "nodes": [
  {
   "id": "b5f7d513-d5c1-5006-b311-fe0e79fda117",
   "name": "Every day 08:00",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "days",
       "triggerAtHour": 8
      }
     ]
    }
   }
  },
  {
   "id": "f3ce231d-241a-5b31-8976-148aea227df3",
   "name": "Window",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    0
   ],
   "parameters": {
    "jsCode": "return [{ json: { window_start: new Date(Date.now() - 24 * 3600 * 1000).toISOString(), request_id: 'daily-' + $execution.id } }];\n"
   }
  },
  {
   "id": "39998440-f6de-5f42-bc81-3aafc0ece963",
   "name": "Log rows",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    1440,
    0
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "q129_log"
    },
    "returnAll": true
   },
   "alwaysOutputData": true,
   "executeOnce": true
  },
  {
   "id": "4ea51ecd-9abe-50f7-aa07-5265a43ffbaa",
   "name": "Attention rows",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    1680,
    0
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "q129_attention"
    },
    "returnAll": true
   },
   "alwaysOutputData": true,
   "executeOnce": true
  },
  {
   "id": "8f20c6d1-eb7b-537b-8fa1-227f55f7da0e",
   "name": "Count",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1920,
    0
   ],
   "parameters": {
    "jsCode": "const W = $('Window').first().json;\nconst end = new Date().toISOString();\nconst inWin = (t) => typeof t === 'string' && t >= W.window_start && t <= end;\nconst log = $('Log rows').all().map((i) => i.json).filter((j) => j && j.id !== undefined && inWin(j.at));\nconst rows = $('Attention rows').all().map((i) => i.json).filter((j) => j && j.id !== undefined && inWin(j.created_at));\nconst count = (r) => log.filter((j) => j.result === r).length;\nconst c = { synced: count('created'), updated: count('updated'), skipped_duplicate: count('skipped_duplicate'),\n  skipped_older: count('skipped_older'), needs_attention: rows.length, still_open: rows.filter((r) => r.state === 'open').length };\nconst text = `Data sync summary (${W.window_start} to ${end}): ${c.synced} new, ${c.updated} updated, `\n  + `${c.skipped_duplicate} duplicates skipped, ${c.skipped_older} older updates skipped, `\n  + `${c.needs_attention} need attention (${c.still_open} still open).`;\nreturn [{ json: { request_id: W.request_id, alert: { type: 'summary', order: '', reason: '', row_id: '', text, data: c },\n  over5: c.needs_attention > 5, counts: c } }];\n"
   },
   "executeOnce": true
  },
  {
   "id": "c038652a-0877-54e5-a254-608bb3844b97",
   "name": "Slack summary",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.3,
   "position": [
    2160,
    0
   ],
   "parameters": {
    "authentication": "accessToken",
    "select": "channel",
    "channelId": {
     "__rl": true,
     "mode": "name",
     "value": "#data-sync-alerts"
    },
    "text": "={{ $json.alert.text }}",
    "otherOptions": {
     "includeLinkToWorkflow": false
    }
   },
   "credentials": {
    "slackApi": {
     "id": "__CRED:slackApi__",
     "name": "Slack n8n-data-sync"
    }
   },
   "onError": "continueRegularOutput",
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000
  },
  {
   "id": "db18c9e1-4cde-5c04-9655-7c5cbf950809",
   "name": "Summary row",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2400,
    0
   ],
   "parameters": {
    "jsCode": "const S = $('Count').first().json;\nconst s = $input.first().json || {};\nconst a = S.alert;\nconst ts = s.ts || (s.message && s.message.ts) || '';\nreturn [{ json: { at: new Date().toISOString(), type: S.alert.type, order_number: a.order || '', reason: a.reason || '',\n  row_id: a.row_id || '', request_id: S.request_id || '', execution_id: String(a.execution_id || $execution.id), slack_ts: String(ts),\n  slack_error: ts ? '' : String((s.error && (s.error.message || s.error)) || 'no message ts').slice(0, 300),\n  text: a.text, data: a.data ? JSON.stringify(a.data) : '' } }];\n"
   }
  },
  {
   "id": "f8e54c29-ca96-5624-91df-7a43b037be0c",
   "name": "Save summary",
   "type": "n8n-nodes-base.dataTable",
