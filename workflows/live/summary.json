  },
  {
   "id": "921812db-dfd2-52e4-9a1b-46317347e62c",
   "name": "Over 5?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    2880,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "921812db-dfd2-52e4-9a1b-46317347e62c",
       "leftValue": "={{ $('Count').first().json.over5 === true }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "looseTypeValidation": true,
    "options": {}
   }
  },
  {
   "id": "708a03d2-aadf-54c0-a69c-70b010be2691",
   "name": "Over 5 state",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    3120,
    170
   ],
   "parameters": {
    "jsCode": "const S = Object.assign({}, $('Count').first().json);\nS.alert = { type: 'over_5', order: '', reason: '', row_id: '', data: S.counts,\n  text: `Alert: ${S.counts.needs_attention} orders needed attention in this window (more than 5). Check the needs-attention list.` };\nreturn [{ json: S }];\n"
   }
  },
