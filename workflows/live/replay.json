   ],
   "parameters": {
    "jsCode": "const f = $input.first().json;\nconst id = Number(f.row_id);\nreturn [{ json: { row_id: Number.isFinite(id) ? id : -1, request_id: String(f.request_id || '') || ('replay-' + $execution.id),\n  received_ms: Date.now() } }];\n"
   }
  },
  {
   "id": "a5442137-9bba-5ed9-8613-656d84b0de1c",
   "name": "Find row",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    480,
    0
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "q129_attention"
    },
    "returnAll": true,
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "id",
       "condition": "eq",
       "keyValue": "={{ $json.row_id }}"
      }
     ]
    }
   },
   "alwaysOutputData": true,
   "executeOnce": true
  },
  {
   "id": "353d0041-5d2c-5d26-bdb7-581c4240fa85",
   "name": "Replay decide",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    0
   ],
   "parameters": {
    "jsCode": "const q = $('Replay request').first().json;\nconst rows = $input.all().map((i) => i.json).filter((j) => j && j.id !== undefined && j.id !== null);\nconst row = rows.find((r) => Number(r.id) === q.row_id) || null;\nlet go = false, reason = null;\nif (!row) reason = 'row_not_found';\nelse if (row.state !== 'open') reason = 'row_closed';\nelse go = true;\nreturn [{ json: { go, reason, row_id: q.row_id, request_id: q.request_id, received_ms: q.received_ms,\n  core: go ? { mode: 'replay', body_text: row.body, request_id: q.request_id, delivery_id: '', topic: '',\n    received_ms: q.received_ms, replay: { row_id: row.id, order: row.order_number || '', replays: Number(row.replays || 0) },\n    user: 'replay', force_crash: false } : null } }];\n"
   },
   "executeOnce": true
  },
  {
   "id": "998afef6-6ba3-51f0-a647-54897e39a4ae",
   "name": "Replay allowed?",
   "type": "n8n-nodes-base.if",
