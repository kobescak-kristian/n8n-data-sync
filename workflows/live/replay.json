      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "998afef6-6ba3-51f0-a647-54897e39a4ae",
       "leftValue": "={{ $json.go === true }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "looseTypeValidation": true,
    "options": {}
   }
  },
  {
   "id": "0e8d69fa-4552-5610-ac14-84420a39006d",
